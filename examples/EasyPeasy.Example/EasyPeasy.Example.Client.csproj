<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>EasyPeasy.Example</RootNamespace>
    <AssemblyName>EasyPeasy.Example</AssemblyName>
    <NoWarn>$(NoWarn);CA1515;CA2007;CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyPeasy.Example.Models\EasyPeasy.Example.Models.csproj" />
    <ProjectReference Include="..\..\src\EasyPeasy\EasyPeasy.csproj" />
    <ProjectReference Include="..\..\src\EasyPeasy.Extensions.DependencyInjection\EasyPeasy.Extensions.DependencyInjection.csproj" />
    <!-- With the NuGet package the generator comes automatically; a project reference has to add it. -->
    <ProjectReference Include="..\..\src\EasyPeasy.SourceGenerator\EasyPeasy.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
