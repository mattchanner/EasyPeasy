<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Declare a REST API as a C# interface and get a typed HttpClient-based client, generated at compile time. Supports System.Text.Json, cancellation, streaming, multipart uploads and Native AOT.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The source generator ships in this package's analyzers folder; it is not a runtime dependency. -->
    <ProjectReference Include="..\EasyPeasy.SourceGenerator\EasyPeasy.SourceGenerator.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="..\EasyPeasy.SourceGenerator\bin\$(Configuration)\netstandard2.0\EasyPeasy.SourceGenerator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
